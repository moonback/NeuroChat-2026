# VITE_GEMINI_API_KEY: Required for local Vite development and current Gemini Live renderer flow.
VITE_GEMINI_API_KEY=""

# GEMINI_API_KEY: Optional fallback used by AI Studio secret injection.
GEMINI_API_KEY=""

# OPENROUTER_API_KEY: Preferred for Electron desktop. Kept in the main process instead of the renderer.
OPENROUTER_API_KEY=""

# VITE_OPENROUTER_API_KEY: Optional web-only fallback. Avoid using this in desktop builds because VITE_* keys are bundled client-side.
VITE_OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional local-first Ollama fallback for agent planning
VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
VITE_OLLAMA_MODEL=llama3.1
